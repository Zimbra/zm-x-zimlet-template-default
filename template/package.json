{
  "private": true,
  "name": "{{name}}",
  "version": "1.0.0",
  "main": "build/index.js",
  "module": "src/index.js",
  "scripts": {
    "prepare": "husky || true",
    "build": "zimlet build",
    "watch": "zimlet watch",
    "start": "zimlet watch",
    "package": "zimlet package --name \"$npm_package_name\" --pkg-version $npm_package_version --zimbraXVersion '^4.0.0'",
    "lint": "eslint src",
    "lint:fix": "npm run lint -- --fix"
  },
  "lint-staged": {
    "src/**/*.{js,mjs}": [
      "eslint --no-warn-ignored"
    ]
  },
  "keywords": [
    "zimlet",
    "Zimbra"
  ],
  "author": "",
  "devDependencies": {
    "@zimbra/eslint-config": "^4.1.0",
    "@zimbra/zimlet-cli": "^19.0.0",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  },
  "dependencies": {
    "@zimbra/x-ui": "^13.1.0",
    "lucide-preact": "^1.47.0"
  }
}
